# =====================================================================
#  HomeEase Auth Service - Application Configuration
# =====================================================================

spring.application.name=auth-service

# ---- server ----
server.port=8081

# ---- database ----
spring.datasource.url=jdbc:mysql://localhost:3306/homeease_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=jk
spring.datasource.password=jk@localhost

# ---- jpa / hibernate ----
# 'validate' is the right choice: Hibernate will check that the entities
# match the schema (which we created by hand from homeease_auth_schema.sql)
# but will NOT create or drop tables. The schema is owned by the SQL file.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ---- JWT ----
# CRITICAL: this exact string must also be set in Mahendra's Express
# .env file as JWT_SECRET. If they differ by one character every
# Booking Service request will fail with 401.
# Change this to a long random string before going live.
app.jwt.secret=nTilO7m6gVreYNLgZjj2KPdYPAunEBYwoUNRPBRCT9bK9
# token lifetime in milliseconds (24 hours)
app.jwt.expiration-ms=86400000

# ---- CORS ----
# The React Native app and React dashboard will run on different
# origins during development. The security config reads this.
app.cors.allowed-origins=http://localhost:5173,http://localhost:19006,exp://localhost:19000
