# Copy this file to .env.local and adjust for your environment.
# Vite only reads env files at startup — restart the dev server after changing them.

# Base URL of the HomeEase Auth Service.
# Serves admin login, the provider endpoints, and the admin user list.
VITE_API_URL=http://localhost:8081

# Base URL of the HomeEase Booking Service.
# Serves bookings and the dashboard analytics endpoints.
#VITE_BOOKING_API_URL=http://localhost:8082
VITE_BOOKING_API_URL=http://172.18.4.16:8082
